ounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#3b82f6;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="client" target="kg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="proxy socket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#3b82f6;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="kg" target="rt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="đẩy sự kiện" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#8b5cf6;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.8;entryY=1;" edge="1" parent="1" source="rt" target="kg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="667" y="245" /><mxPoint x="437" y="245" /></Array></mxGeometry></mxCell><mxCell id="e5" value="cập nhật giao diện" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#8b5cf6;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="kg" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="332" y="263" /><mxPoint x="115" y="263" /></Array></mxGeometry></mxCell><mxCell id="rtcaption" value="Communication lưu chat trong PostgreSQL, dùng Redis adapter cho Pub/Sub.&lt;br&gt;Notification lưu thông báo rồi phát new_notification theo room người dùng; Web Push là kênh riêng." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#53657a;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="720" height="30" as="geometry" /></mxCell><mxCell id="uploadlabel" value="&lt;b&gt;B. TÀI LIỆU: UPLOAD BẰNG PRESIGNED URL&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#15324f;" vertex="1" parent="1"><mxGeometry x="40" y="331" width="720" height="20" as="geometry" /></mxCell><mxCell id="u" value="&lt;b&gt;WEB CLIENT&lt;/b&gt;&lt;br&gt;1. Yêu cầu upload&lt;br&gt;3. Gửi nội dung tệp" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#15324f;strokeColor=#15324f;fontColor=#ffffff;fontFamily=Arial;fontSize=12;spacing=7;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="372" width="150" height="70" as="geometry" /></mxCell><mxCell id="d" value="&lt;b&gt;KONG → DOCUMENT&lt;/b&gt;&lt;br&gt;2. Kiểm tra quyền / quota&lt;br&gt;Cấp presigned URL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="372" width="190" height="70" as="geometry" /></mxCell><mxCell id="s" value="&lt;b&gt;S3 OBJECT STORAGE&lt;/b&gt;&lt;br&gt;Nhận file bằng PUT&lt;br&gt;qua URL có chữ ký" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="372" width="160" height="70" as="geometry" /></mxCell><mxCell id="e6" value="1 · initiate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#3b82f6;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="u" target="d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="2 · URL + key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#3b82f6;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.8;entryY=1;" edge="1" parent="1" source="d" target="u"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="347" y="465" /><mxPoint x="160" y="465" /></Array></mxGeometry></mxCell><mxCell id="e8" value="3 · PUT trực tiếp S3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#059669;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="u" target="s"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="85" y="493" /><mxPoint x="680" y="493" /></Array></mxGeometry></mxCell><mxCell id="confirm" value="&lt;b&gt;4 · XÁC NHẬN UPLOAD&lt;/b&gt;&lt;br&gt;Web → Kong → Document: /api/documents/upload/confirm → lưu metadata / phiên bản trong document_db.&lt;br&gt;File của Project hiện lưu trong project_db; không áp dụng luồng S3 này cho mọi loại file." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="519" width="720" height="46" as="geometry" /></mxCell><mxCell id="footer" value="WorkSpaceHub • Kiến trúc từ mã nguồn và cấu hình Docker • 06/09/2026                                     7/7" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontColor=#53657a;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="720" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="master" name="00 - Kiến trúc toàn hệ thống"><mxGraphModel page="1" pageScale="1" pageWidth="1800" pageHeight="1320" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Kiến trúc Microservices của Nền tảng AI Workspace&lt;/b&gt;" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Arial;fontSize=32;fon