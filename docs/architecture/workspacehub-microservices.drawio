ometry x="415" y="125" width="345" height="64" as="geometry" /></mxCell><mxCell id="e2" value="HTTP request / response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#3b82f6;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p0" target="c0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b&gt;Calendar&lt;/b&gt;&lt;br&gt;Kiểm tra quyền tài nguyên" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#17324d;fontFamily=Arial;fontSize=11;spacing=7;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="185" height="64" as="geometry" /></mxCell><mxCell id="c1" value="&lt;b&gt;Project :8082 + Document :8085&lt;/b&gt;&lt;br&gt;GET project / document access" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#17324d;fontFamily=Arial;fontSize=11;spacing=7;" vertex="1" parent="1"><mxGeometry x="415" y="225" width="345" height="64" as="geometry" /></mxCell><mxCell id="e3" value="HTTP request / response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#3b82f6;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b&gt;Calendar&lt;/b&gt;&lt;br&gt;Bổ sung snapshot người dùng" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#17324d;fontFamily=Arial;fontSize=11;spacing=7;" vertex="1" parent="1"><mxGeometry x="40" y="325" width="185" height="64" as="geometry" /></mxCell><mxCell id="c2" value="&lt;b&gt;User :8081&lt;/b&gt;&lt;br&gt;API tra cứu hồ sơ người dùng" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#17324d;fontFamily=Arial;fontSize=11;spacing=7;" vertex="1" parent="1"><mxGeometry x="415" y="325" width="345" height="64" as="geometry" /></mxCell><mxCell id="e4" value="HTTP request / response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#3b82f6;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="outbox" value="&lt;b&gt;PROJECT → NOTIFICATION KHÔNG CÒN GỌI HTTP&lt;/b&gt;&lt;br&gt;Project ghi notification_outbox trong transaction → relay publish Kafka → Notification ghi processed_events và dữ liệu nghiệp vụ trong cùng transaction.&lt;br&gt;Project chỉ gọi User Service qua HTTP khi cần làm giàu dữ liệu email trước khi publish." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#17324d;fontFamily=Arial;fontSize=11;spacing=7;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="435" width="720" height="90" as="geometry" /></mxCell><mxCell id="footer" value="WorkSpaceHub • Kiến trúc từ mã nguồn và cấu hình Docker • 07/09/2026                                     5/10" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontColor=#53657a;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="720" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="06 - Luồng Task và Calendar"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="800" pageHeight="600" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;06  LUỒNG NGHIỆP VỤ: TASK → LỊCH → NHẮC VIỆC&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#15324f;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="720" height="32" as="geometry" /></mxCell><mxCell id="subtitle" value="Ví dụ trình bày: cập nhật deadline công việc rồi nhận thông báo khi đến giờ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#53657a;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="720" height="28" as="geometry" /></mxCell><mxCell id="phase1" value="&lt;b&gt;A. LƯU CÔNG VIỆC VÀ ĐỒNG BỘ LỊCH&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#15324f;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="720" height="22" as="geometry" /></mxCell><mxCell id="web" value="&lt;b&gt;1 · WEB → KONG&lt;/b&gt;&lt;br&gt;Người dùng sửa task&lt;br&gt;REST → Project" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;" vertex="1" parent="1"><mxGeometry x="40" y="143" width="140" height="78" as="geometry" /></mxCell><mxCell id="outbox" value="&lt;b&gt;2 · PROJECT + DB&lt;/b&gt;&lt;br&gt;Lưu task + outbox&lt;br&gt;Trong giao dịch DB" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;" vertex="1" parent="1"><mxGeometry x="235" y="143" width="150" height="78" as="geometry" /></mxCell><mxCell id="kafka" value="&lt;b&gt;3 · KAFKA&lt;/b&gt;&lt;br&gt;Worker phát&lt;br&gt;project-task-events" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="143" width="140" height="78" as="geometry" /></mxCell><mxCell id="cal" value="&lt;b&gt;4 · CALENDAR&lt;/b&gt;&lt;br&gt;Upsert / remove&lt;br&gt;Lưu calendar_db" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;" vertex="1" parent="1"><mxGeometry x="625" y="143" width="135" height="78" as="geometry" /></mxCell><mxCell id="e2" value="request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#3b82f6;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="outbox"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="sau commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#ea580c;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="outbox" target="kafka"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#ea580c;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="kafka" target="cal"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="syncnote" value="&lt;b&gt;KẾT QUẢ&lt;/b&gt;&lt;br&gt;Lịch được cập nhật sau khi consumer xử lý; có độ trễ đồng bộ giữa hai dịch vụ (eventual consistency)." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="247" width="720" height="45" as="geometry" /></mxCell><mxCell id="phase2" value="&lt;b&gt;B. NHẮC VIỆC KHI SỰ KIỆN CÓ REMINDER ĐẾN HẠN&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#15324f;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="720" height="22" as="geometry" /></mxCell><mxCell id="rem" value="&lt;b&gt;5 · CALENDAR&lt;/b&gt;&lt;br&gt;Quét Reminder&lt;br&gt;mỗi 30 giây&lt;br&gt;Claim bản ghi đến hạn" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="140" height="85" as="geometry" /></mxCell><mxCell id="kt" value="&lt;b&gt;6 · KAFKA&lt;/b&gt;&lt;br&gt;calendar-reminder-&lt;br&gt;events&lt;br&gt;CALENDAR_REMINDER_DUE" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="235" y="355" width="150" height="85" as="geometry" /></mxCell><mxCell id="nt" value="&lt;b&gt;7 · NOTIFICATION&lt;/b&gt;&lt;br&gt;Nhận sự kiện&lt;br&gt;Chọn kênh theo&lt;br&gt;method của reminder" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="355" width="140" height="85" as="geometry" /></mxCell><mxCell id="dest" value="&lt;b&gt;8 · NGƯỜI NHẬN&lt;/b&gt;&lt;br&gt;ALERT: app&lt;br&gt;PUSH: app + push&lt;br&gt;EMAIL: hộp thư" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;fontSize=11;" vertex="1" parent="1"><mxGeometry x="625" y="355" width="135" height="85" as="geometry" /></mxCell><mxCell id="e5" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#ea580c;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="rem" target="kt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#ea580c;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="kt" target="nt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="phân phối" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#3b82f6;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nt" target="dest"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="reliability" value="&lt;b&gt;CƠ CHẾ HỖ TRỢ ĐỘ TIN CẬY&lt;/b&gt;&lt;br&gt;Project: outbox + retry; Calendar: trạng thái xử lý, retry có khoảng lùi và DEAD_LETTER trong DB.&lt;br&gt;Checkpoint hỗ trợ đồng bộ task. DEAD_LETTER ở đây không phải một Kafka DLQ riêng.&lt;br&gt;Luồng minh họa giả định sự kiện đã có reminder; đồng bộ task không có nghĩa tự tạo reminder." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#17324d;fontFamily=Arial;fontSize=12;spacing=7;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="720" height="87" as="geometry" /></mxCell><mxCell id="footer" value="WorkSpaceHub • Kiến trúc từ mã nguồn và cấu hình Docker • 06/09/2026                                     6/7" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontColor=#53657a;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="720" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="realtime" name="07 - Realtime và upload"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="800" pageHeight="600" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt