yle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#ea580c;strokeWidth=2;endArrow=block;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="ep4" target="et4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="line27" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#ea580c;strokeWidth=2;endArrow=block;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="et4" target="ec4"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="auth" name="08 - Authentication"><mxGraphModel page="1" pageWidth="800" pageHeight="600" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;08  XÁC THỰC &amp; PHÂN QUYỀN&lt;/b&gt;" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="720" height="30" as="geometry" /></mxCell><mxCell id="sub" value="User Service phát token; Kong và các guard xử lý theo cấu hình thực tế." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry x="40" y="69" width="720" height="25" as="geometry" /></mxCell><mxCell id="web" value="&lt;b&gt;WEB CLIENT&lt;/b&gt;&lt;br&gt;Email / mật khẩu&lt;br&gt;hoặc Google OAuth" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#16324f;fontFamily=Arial;fontSize=16;spacing=9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="155" height="70" as="geometry" /></mxCell><mxCell id="kg" value="&lt;b&gt;KONG&lt;/b&gt;&lt;br&gt;/api/auth/login&lt;br&gt;/api/auth/social" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#16324f;fontFamily=Arial;fontSize=16;spacing=9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="125" width="170" height="70" as="geometry" /></mxCell><mxCell id="user" value="&lt;b&gt;USER :8081&lt;/b&gt;&lt;br&gt;Kiểm tra thông tin&lt;br&gt;Cấp access token" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#16324f;fontFamily=Arial;fontSize=16;spacing=9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="125" width="170" height="70" as="geometry" /></mxCell><mxCell id="line2" value="1 · đăng nhập" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#3b82f6;strokeWidth=2;endArrow=block;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="web" target="kg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="line3" value="2 · chuyển tiếp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#3b82f6;strokeWidth=2;endArrow=block;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="kg" target="user"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tokens" value="&lt;b&gt;3 · TRẢ TOKEN QUA KONG VỀ WEB&lt;/b&gt;&lt;br&gt;Access token: JWT HS256, TTL 15 phút → Redux.&lt;br&gt;Refresh token: cookie HttpOnly / Secure / SameSite=Lax.&lt;br&gt;TTL refresh: 7 ngày; bản băm và trạng thái lưu trong DB." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#16324f;fontFamily=Arial;fontSize=16;spacing=9;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="239" width="435" height="82" as="geometry" /></mxCell><mxCell id="db" value="&lt;b&gt;user_db&lt;/b&gt;&lt;br&gt;User / OAuthAccount&lt;br&gt;RefreshToken hash&lt;br&gt;Thu hồi phiên trong DB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#16324f;fontFamily=Arial;fontSize=16;spacing=9;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="239" width="170" height="82" as="geometry" /></mxCell><mxCell id="line4" value="lưu / kiểm tra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#059669;strokeWidth=2;endArrow=block;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="apiweb" value="&lt;b&gt;4 · WEB GỌI API&lt;/b&gt;&lt;br&gt;Authorization:&lt;br&gt;Bearer accessToken" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#16324f;fontFamily=Arial;fontSize=16;spacing=9;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="155" height="72" as="geometry" /></mxCell><mxCell id="guard" value="&lt;b&gt;5 · KONG&lt;/b&gt;&lt;br&gt;JWT + exp&lt;br&gt;Gắn X-User-*" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#16324f;fontFamily=Arial;fontSize=16;spacing=9;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="376" width="170" height="72" as="geometry" /></mxCell><mxCell id="backend" value="&lt;b&gt;6 · MICROSERVICE&lt;/b&gt;&lt;br&gt;Kiểm tra quyền nghiệp vụ&lt;br&gt;Project: JWT guard riêng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#16324f;fontFamily=Arial;fontSize=16;spacing=9;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="376" width="170" height="72" as="geometry" /></mxCell><mxCell id="line5" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#3b82f6;strokeWidth=2;endArrow=block;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="apiweb" target="guard"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="line6" value="token + context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#3b82f6;strokeWidth=2;endArrow=block;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="guard" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;LƯU Ý ĐÚNG VỚI MÃ NGUỒN&lt;/b&gt;&lt;br&gt;401 → Web gọi /api/auth/refresh bằng cookie, lấy access token rồi thử lại request.&lt;br&gt;Redis dùng OTP; chưa thấy token blacklist. User Spring Security hiện permitAll ở filter chain.&lt;br&gt;Socket gateways đọc payload token để lấy userId; chưa thấy kiểm tra chữ ký/exp trong handshake." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#16324f;fontFamily=Arial;fontSize=16;spacing=9;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="477" width="720" height="84" as="geometry" /></mxCell><mxCell id="footer" value="WorkSpaceHub • AuthController / AuthService / JwtService / Kong / JwtIdentityGuard / frontend interceptors" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Arial;fontSize=9;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry x="40" y="576" width="720" height="16" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="capability-status" name="09 - AI và Pomodoro"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="800" pageHeight="600" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;09  AI &amp; POMODORO — TRẠNG THÁI TRIỂN KHAI&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=22;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="720" height="34" as="geometry" /></mxCell><mxCell id="sub" value="Phân biệt bằng chứng hiện tại với kiến trúc mục tiêu để tránh trình bày sai trước hội đồng." style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontSize=11;fontColor=#53657a;" vertex="1" parent="1"><mxGeometry 