project-notification-events-retry (tối đa 3 lần) • Payload sai hoặc hết retry → project-notification-events-dlt • processed_events chống consume trùng." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#17324d;fontFamily=Arial;fontSize=11;spacing=7;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="720" height="55" as="geometry" /></mxCell><mxCell id="footer" value="WorkSpaceHub • Kiến trúc từ mã nguồn và cấu hình Docker • 07/09/2026                                     4/10" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=9;fontColor=#53657a;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="720" height="18" as="geometry" /></mxCell><mxCell id="p4" value="&lt;b&gt;Calendar&lt;/b&gt;&lt;br&gt;Reminder worker" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#17324d;fontFamily=Arial;fontSize=11;spacing=7;" vertex="1" parent="1"><mxGeometry x="40" y="432" width="160" height="58" as="geometry" /></mxCell><mxCell id="t4" value="&lt;b&gt;calendar-reminder-events&lt;/b&gt;&lt;br&gt;CALENDAR_REMINDER_DUE" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#17324d;fontFamily=Arial;fontSize=11;spacing=7;" vertex="1" parent="1"><mxGeometry x="260" y="432" width="280" height="58" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Notification&lt;/b&gt;&lt;br&gt;ALERT / PUSH / EMAIL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#17324d;fontFamily=Arial;fontSize=11;spacing=7;" vertex="1" parent="1"><mxGeometry x="600" y="432" width="160" height="58" as="geometry" /></mxCell><mxCell id="e10" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#ea580c;fontColor=#334155;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX