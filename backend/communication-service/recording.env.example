MEETING_RECORDING_ENABLED=true
JWT_SECRET_KEY=the-same-signing-secret-as-user-service-and-kong
JWT_ISSUER=workspace-hub
MEETING_RECORDING_MAX_CONCURRENT=1
MEETING_RECORDING_MAX_MINUTES=120
# all, control, upload or off; retain at least one control process.
MEETING_RECORDING_WORKER_ROLE=all
# Recovery uploads: 5-64 MiB per part, 1-4 parallel parts per process.
MEETING_RECORDING_UPLOAD_PART_MIB=16
MEETING_RECORDING_UPLOAD_CONCURRENCY=3
MEETING_RECORDING_PAUSE_ENABLED=true
RECORDING_FFMPEG_PATH=ffmpeg
# Mount a shared durable volume on control/upload processes using Pause/Resume.
RECORDING_WORK_ROOT=/recording-work
LIVEKIT_EGRESS_WEBHOOK_URL=http://communication-service:8083/api/meetings/livekit/webhook
# Both LiveKit and the communication service must use the same key pair.
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
AWS_REGION=your-bucket-region
AWS_S3_BUCKET_NAME=your-private-bucket
AWS_ACCESS_KEY=your-s3-access-key
AWS_SECRET_KEY=your-s3-secret-key
RECORDING_BACKUP_ROOT=/recording-backup
# Optional S3-compatible storage settings; use a browser-reachable endpoint.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
# Use this frontend route for automatic share/speaker/gallery layouts; leave empty for LiveKit defaults.
LIVEKIT_RECORDING_TEMPLATE_URL=http://host.docker.internal:3000/recording-template
