MEETING_RECORDING_ENABLED=true
JWT_SECRET_KEY=the-same-signing-secret-as-user-service-and-kong
JWT_ISSUER=workspace-hub
MEETING_RECORDING_MAX_CONCURRENT=1
MEETING_RECORDING_MAX_MINUTES=120
LIVEKIT_EGRESS_WEBHOOK_URL=http://communication-service:8083/api/meetings/livekit/webhook
# Both LiveKit and the communication service must use the same key pair.
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
AWS_REGION=your-bucket-region
AWS_S3_BUCKET_NAME=your-private-bucket
AWS_ACCESS_KEY=your-s3-access-key
AWS_SECRET_KEY=your-s3-secret-key
RECORDING_BACKUP_ROOT=/recording-backup
# Optional S3-compatible storage settings; use a browser-reachable endpoint.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
# Optional custom server composition template. Leave empty for built-in layouts.
LIVEKIT_RECORDING_TEMPLATE_URL=
