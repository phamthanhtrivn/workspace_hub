# WorkSpaceHub — communication-service — LOCAL DEVELOPMENT
# So sánh với .env hiện tại trước khi copy. Thay REPLACE_* bằng giá trị local của bạn.
# Dòng không comment: cấu hình nền cho mẫu này; vẫn phải điền credential/URL thật.
# Dòng "# NAME=...": tùy chọn, tuning hoặc feature có điều kiện; chỉ bỏ comment khi dùng.
# Không commit .env thật. File này KHÔNG triển khai phần fix security.
# Các key API_* ở cuối file là kế hoạch, hiện CHƯA được source đọc.

# Development loader nạp .env.local với override=true; kiểm tra file đó nếu giá trị khác dự kiến.

# ============================================================================
# 01. Runtime / frontend / CORS
# ============================================================================
# CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
PORT=8083

# ============================================================================
# 02. Database / schema tooling (credential hiện tại)
# ============================================================================
# Giữ DB/role/password đang dùng; chỉ đổi sang role riêng SAU khi role và quyền đã được tạo. Encode password trong URL.
DATABASE_URL=postgresql://REPLACE_WITH_EXISTING_DB_ROLE:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@127.0.0.1:5433/communication_db

# ============================================================================
# 03. User authentication / JWT / trusted proxy
# ============================================================================
JWT_ISSUER=workspace-hub
# Cùng secret với User Service và các verifier; không dùng API key thay JWT.
JWT_SECRET_KEY=REPLACE_WITH_SHARED_JWT_SECRET_AT_LEAST_32_BYTES

# ============================================================================
# 04. API nội bộ HIỆN TẠI — giữ tới khi chuyển code
# ============================================================================
# LEGACY: hiện phải khớp các backend còn dùng key chung; API_INTERNAL_KEY bên dưới chưa thay thế được.
INTERNAL_SERVICE_KEY=REPLACE_WITH_SHARED_LEGACY_INTERNAL_KEY

# ============================================================================
# 05. Endpoint HTTP / timeout gọi service khác
# ============================================================================
# AI_SERVICE_URL=http://127.0.0.1:8087
# CAPTION_SERVICE_URL=https://replace-with-caption-provider.example.com
PROJECT_SERVICE_URL=http://127.0.0.1:8082
# SERVICE_HTTP_TIMEOUT_MS=5000
USER_SERVICE_URL=http://127.0.0.1:8081

# ============================================================================
# 06. Redis / Kafka / outbox
# ============================================================================
KAFKA_BROKER=127.0.0.1:9092
REDIS_URL=redis://127.0.0.1:6379

# ============================================================================
# 07. AWS S3 / media storage
# ============================================================================
# Có thể bỏ cả cặp AWS key khi SDK dùng credential chain; recording hiện còn yêu cầu cặp này để bật.
# AWS_ACCESS_KEY=REPLACE_WITH_AWS_ACCESS_KEY
# Giữ media base URL hiện hữu. Calendar chỉ dùng cho audio; không biến document riêng tư thành public.
# AWS_CLOUDFRONT_URL=https://media.example.com
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=replace-with-your-bucket
# Chỉ bật khi dùng S3-compatible/local endpoint; AWS S3 chuẩn thường bỏ biến này.
# AWS_S3_ENDPOINT=http://127.0.0.1:9000
# Chỉ bật khi endpoint tương thích S3 yêu cầu; mặc định AWS là false.
# AWS_S3_FORCE_PATH_STYLE=true
# Phải đi cùng AWS_ACCESS_KEY nếu dùng static credentials; không commit credential thật.
# AWS_SECRET_KEY=REPLACE_WITH_AWS_SECRET_KEY

# ============================================================================
# 09. LiveKit / recording / captions
# ============================================================================
# Credential provider Caption; bật cùng CAPTION_SERVICE_URL. Không sinh thay token provider tùy ý.
# CAPTION_SERVICE_TOKEN=REPLACE_WITH_CAPTION_PROVIDER_TOKEN
# Khớp key pair LiveKit, Communication và Egress.
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
# Khớp key pair LiveKit, Communication và Egress; không phải API_INTERNAL_KEY.
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET
# URL nhìn từ container LiveKit/Egress; host.docker.internal phải resolve được trên máy bạn.
# LIVEKIT_EGRESS_WEBHOOK_URL=http://host.docker.internal:8083/api/meetings/livekit/webhook
# WebSocket URL browser truy cập được, không dùng Docker DNS cho trình duyệt.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Chỉ bật recording sau khi đặt đường dẫn template thực tế truy cập được từ Egress.
# LIVEKIT_RECORDING_TEMPLATE_URL=http://host.docker.internal:3000/REPLACE_WITH_EXISTING_RECORDING_TEMPLATE_PATH
# HTTP URL cho server SDK; LiveKit chạy container được expose ra host.
LIVEKIT_URL=http://127.0.0.1:7880
# Mẫu tắt recording. Bật cần LiveKit/Egress, template, webhook, S3 và credential phù hợp.
MEETING_RECORDING_ENABLED=false
# MEETING_RECORDING_MAX_CONCURRENT=1
# MEETING_RECORDING_MAX_MINUTES=120
# Mẫu tắt pause/post-processing; bật cần ffmpeg và work directory phù hợp.
MEETING_RECORDING_PAUSE_ENABLED=false
# MEETING_RECORDING_UPLOAD_CONCURRENCY=3
# MEETING_RECORDING_UPLOAD_PART_MIB=16
# MEETING_RECORDING_WORKER_ROLE=all
# RECORDING_BACKUP_ROOT=REPLACE_WITH_ABSOLUTE_LOCAL_BACKUP_DIRECTORY
# RECORDING_FFMPEG_PATH=ffmpeg
# RECORDING_WORK_ROOT=REPLACE_WITH_ABSOLUTE_LOCAL_WORK_DIRECTORY

# ============================================================================
# 11. AI feature flags / model / RAG / speech
# ============================================================================
# Khớp AI và Communication; cần khi bật Conversation AI hoặc Meeting Summary.
# AI_COMMUNICATION_SERVICE_KEY=REPLACE_WITH_SHARED_AI_COMMUNICATION_KEY
# Bật đồng bộ Communication/AI và cấu hình AI_COMMUNICATION_SERVICE_KEY.
CONVERSATION_AI_ENABLED=false
# Bật đồng bộ Communication/AI; cần speech worker, media allowlist và key đúng.
MEETING_SUMMARY_ENABLED=false

# ============================================================================
# 12. API key contract MỚI — PLANNED / CHƯA ĐƯỢC CODE HIỆN TẠI ĐỌC
# Chỉ chuẩn bị/đối chiếu. Chưa xóa key legacy bên trên.
# Mỗi target một secret; outgoing phải bằng API_INTERNAL_KEY của receiver.
# Key receiver không phân biệt các caller cùng giữ key; vẫn cần kiểm tra quyền user.
# ============================================================================
# Incoming: key của chính service này.
# API_INTERNAL_KEY=REPLACE_WITH_COMMUNICATION_SERVICE_INTERNAL_KEY
# Outgoing → user; bằng API_INTERNAL_KEY tại receiver.
# API_USER_SERVICE_KEY=REPLACE_WITH_USER_SERVICE_INTERNAL_KEY
# Outgoing → project; bằng API_INTERNAL_KEY tại receiver.
# API_PROJECT_SERVICE_KEY=REPLACE_WITH_PROJECT_SERVICE_INTERNAL_KEY
# Outgoing → ai; bằng API_INTERNAL_KEY tại receiver.
# API_AI_SERVICE_KEY=REPLACE_WITH_AI_SERVICE_INTERNAL_KEY

