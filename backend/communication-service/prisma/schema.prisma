generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* =========================================================
 * ENUMS
 * ========================================================= */

enum SpaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum MediaType {
  FILE
  IMAGE
  VIDEO
}

enum MessageType {
  TEXT
  SYSTEM
  TASK
  POLL
  NOTE
  EVENT
  AI
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/* =========================================================
 * SPACE
 * ========================================================= */

model Space {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  createdBy   String            @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  channels    Channel[]
  members     SpaceMember[]
  invitations SpaceInvitation[]

  @@map("spaces")
}

/* =========================================================
 * SPACE MEMBER
 * ========================================================= */

model SpaceMember {
  id        String    @id @default(uuid()) @db.Uuid
  spaceId   String    @map("space_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      SpaceRole
  joinedAt  DateTime  @default(now()) @map("joined_at")

  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

/* =========================================================
 * SPACE INVITATION
 * ========================================================= */

model SpaceInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  spaceId       String           @map("space_id") @db.Uuid
  invitedUserId String           @map("invited_user_id") @db.Uuid
  invitedBy     String           @map("invited_by") @db.Uuid
  invitedByName String?          @map("invited_by_name")
  invitedByAvatar String?        @map("invited_by_avatar")
  invitedUserName String?        @map("invited_user_name")
  invitedUserAvatar String?      @map("invited_user_avatar")
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now()) @map("created_at")
  respondedAt   DateTime?        @map("responded_at")

  space         Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, invitedUserId])
  @@map("space_invitations")
}

/* =========================================================
 * CHANNEL
 * ========================================================= */

model Channel {
  id          String          @id @default(uuid()) @db.Uuid
  spaceId     String          @map("space_id") @db.Uuid
  name        String
  avatarUrl   String?         @map("avatar_url")
  createdBy   String          @map("created_by") @db.Uuid
  isDefault   Boolean         @default(false) @map("is_default")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  space       Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  setting     ChannelSetting?
  members     ChannelMember[]
  messages    Message[]

  @@index([spaceId])
  @@map("channels")
}

/* =========================================================
 * CHANNEL MEMBER (FOR READ STATE & MUTE STATUS)
 * ========================================================= */

model ChannelMember {
  id                String    @id @default(uuid()) @db.Uuid
  channelId         String    @map("channel_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  joinedAt          DateTime  @default(now()) @map("joined_at")
  lastReadMessageId String?   @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime? @map("last_read_at")
  muted             Boolean   @default(false)
  nickname          String?

  channel           Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("channel_members")
}

/* =========================================================
 * CHANNEL SETTING
 * ========================================================= */

model ChannelSetting {
  id                String  @id @default(uuid()) @db.Uuid
  channelId         String  @unique @map("channel_id") @db.Uuid
  allowSendMessage  Boolean @default(true) @map("allow_send_message")
  allowCreatePoll   Boolean @default(true) @map("allow_create_poll")
  allowCreateNote   Boolean @default(true) @map("allow_create_note")
  allowPinMessage   Boolean @default(true) @map("allow_pin_message")

  channel           Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("channel_settings")
}

/* =========================================================
 * MESSAGE (GROUP CHANNEL MESSAGE)
 * ========================================================= */

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  channelId         String           @map("channel_id") @db.Uuid
  senderId          String           @map("sender_id") @db.Uuid
  content           String?
  type              MessageType
  edited            Boolean          @default(false)
  pinned            Boolean          @default(false)
  recalled          Boolean          @default(false)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  /* Thread */
  threadParentId    String?          @map("thread_parent_id") @db.Uuid
  threadReplyCount  Int              @default(0) @map("thread_reply_count")
  threadLastReplyAt DateTime?        @map("thread_last_reply_at")

  channel           Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  threadParent      Message?         @relation("ThreadReplies", fields: [threadParentId], references: [id], onDelete: Cascade)
  threadReplies     Message[]        @relation("ThreadReplies")

  reactions         Reaction[]
  medias            Media[]
  note              Note?
  poll              Poll?
  threadFollowers   ThreadFollower[]

  @@index([channelId, createdAt])
  @@index([senderId])
  @@map("messages")
}

/* =========================================================
 * DIRECT CONVERSATION
 * ========================================================= */

model DirectConversation {
  id           String                          @id @default(uuid()) @db.Uuid
  createdAt    DateTime                        @default(now()) @map("created_at")
  updatedAt    DateTime                        @updatedAt @map("updated_at")

  participants DirectConversationParticipant[]
  messages     DirectMessage[]

  @@map("direct_conversations")
}

/* =========================================================
 * DIRECT CONVERSATION PARTICIPANT
 * ========================================================= */

model DirectConversationParticipant {
  id                String             @id @default(uuid()) @db.Uuid
  conversationId    String             @map("conversation_id") @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  joinedAt          DateTime           @default(now()) @map("joined_at")
  lastReadMessageId String?            @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime?          @map("last_read_at")
  muted             Boolean            @default(false)
  pinned            Boolean            @default(false)

  conversation      DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("direct_conversation_participants")
}

/* =========================================================
 * DIRECT MESSAGE
 * ========================================================= */

model DirectMessage {
  id               String           @id @default(uuid()) @db.Uuid
  conversationId   String           @map("conversation_id") @db.Uuid
  senderId         String           @map("sender_id") @db.Uuid
  content          String?
  type             MessageType
  edited           Boolean          @default(false)
  pinned           Boolean          @default(false)
  recalled         Boolean          @default(false)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  /* Thread */
  threadParentId    String?          @map("thread_parent_id") @db.Uuid
  threadReplyCount  Int              @default(0) @map("thread_reply_count")
  threadLastReplyAt DateTime?        @map("thread_last_reply_at")

  conversation     DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  threadParent      DirectMessage?   @relation("DirectThreadReplies", fields: [threadParentId], references: [id], onDelete: Cascade)
  threadReplies     DirectMessage[]  @relation("DirectThreadReplies")

  reactions        DirectReaction[]
  medias           DirectMedia[]
  threadFollowers  DirectThreadFollower[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("direct_messages")
}

/* =========================================================
 * MEDIA
 * ========================================================= */

model Media {
  id        String    @id @default(uuid()) @db.Uuid
  messageId String    @map("message_id") @db.Uuid
  name      String
  s3Key     String    @map("s3_key")
  mimeType  String    @map("mime_type")
  sizeBytes Int       @map("size_bytes")
  type      MediaType

  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("medias")
}

/* =========================================================
 * DIRECT MEDIA
 * ========================================================= */

model DirectMedia {
  id        String        @id @default(uuid()) @db.Uuid
  messageId String        @map("message_id") @db.Uuid
  name      String
  s3Key     String        @map("s3_key")
  mimeType  String        @map("mime_type")
  sizeBytes Int           @map("size_bytes")
  type      MediaType

  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("direct_medias")
}

/* =========================================================
 * REACTION
 * ========================================================= */

model Reaction {
  id        String  @id @default(uuid()) @db.Uuid
  messageId String  @map("message_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  emoji     String

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("reactions")
}

/* =========================================================
 * DIRECT REACTION
 * ========================================================= */

model DirectReaction {
  id        String        @id @default(uuid()) @db.Uuid
  messageId String        @map("message_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  emoji     String

  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("direct_reactions")
}

/* =========================================================
 * NOTE
 * ========================================================= */

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @unique @map("message_id") @db.Uuid
  title     String
  content   String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("notes")
}

/* =========================================================
 * POLL
 * ========================================================= */

model Poll {
  id              String       @id @default(uuid()) @db.Uuid
  messageId       String       @unique @map("message_id") @db.Uuid
  title           String
  multipleChoice  Boolean      @map("multiple_choice")
  allowAddOptions Boolean      @map("allow_add_options")
  anonymous       Boolean
  isLocked        Boolean      @default(false) @map("is_locked")
  expiresAt       DateTime?    @map("expires_at")
  createdBy       String       @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  message         Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options         PollOption[]

  @@map("polls")
}

/* =========================================================
 * POLL OPTION
 * ========================================================= */

model PollOption {
  id        String     @id @default(uuid()) @db.Uuid
  pollId    String     @map("poll_id") @db.Uuid
  text      String
  createdBy String?    @map("created_by") @db.Uuid

  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@map("poll_options")
}

/* =========================================================
 * POLL VOTE
 * ========================================================= */

model PollVote {
  id           String     @id @default(uuid()) @db.Uuid
  pollOptionId String     @map("poll_option_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  option       PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)

  @@unique([pollOptionId, userId])
  @@map("poll_votes")
}

/* =========================================================
 * THREAD FOLLOWER
 * ========================================================= */

model ThreadFollower {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("thread_followers")
}

model DirectThreadFollower {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("direct_thread_followers")
}
