# WorkSpaceHub — livekit — LOCAL DEVELOPMENT
# So sánh với .env hiện tại trước khi copy. Thay REPLACE_* bằng giá trị local của bạn.
# Dòng không comment: cấu hình nền cho mẫu này; vẫn phải điền credential/URL thật.
# Dòng "# NAME=...": tùy chọn, tuning hoặc feature có điều kiện; chỉ bỏ comment khi dùng.
# Không commit .env thật. File này KHÔNG triển khai phần fix security.
# Các key API_* ở cuối file là kế hoạch, hiện CHƯA được source đọc.

# ============================================================================
# 09. LiveKit / recording / captions
# ============================================================================
# Khớp key pair LiveKit, Communication và Egress.
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
# Khớp key pair LiveKit, Communication và Egress; không phải API_INTERNAL_KEY.
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET
# LIVEKIT_EGRESS_SECCOMP_PROFILE=../livekit/config/chrome-sandboxing-seccomp-profile.json
# URL nhìn từ container LiveKit/Egress; host.docker.internal phải resolve được trên máy bạn.
LIVEKIT_EGRESS_WEBHOOK_URL=http://host.docker.internal:8083/api/meetings/livekit/webhook
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882

