LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
# Egress and LiveKit must be able to reach this address.
LIVEKIT_EGRESS_WEBHOOK_URL=http://host.docker.internal:8083/api/meetings/livekit/webhook
# Optional absolute seccomp profile path if the main Compose file is moved.
LIVEKIT_EGRESS_SECCOMP_PROFILE=
