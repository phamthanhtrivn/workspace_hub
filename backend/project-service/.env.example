# WorkSpaceHub — project-service — LOCAL DEVELOPMENT
# So sánh với .env hiện tại trước khi copy. Thay REPLACE_* bằng giá trị local của bạn.
# Dòng không comment: cấu hình nền cho mẫu này; vẫn phải điền credential/URL thật.
# Dòng "# NAME=...": tùy chọn, tuning hoặc feature có điều kiện; chỉ bỏ comment khi dùng.
# Không commit .env thật. File này KHÔNG triển khai phần fix security.
# Các key API_* ở cuối file là kế hoạch, hiện CHƯA được source đọc.

# ============================================================================
# 01. Runtime / frontend / CORS
# ============================================================================
# CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PORT=8082

# ============================================================================
# 02. Database / schema tooling (credential hiện tại)
# ============================================================================
# Giữ DB/role/password đang dùng; chỉ đổi sang role riêng SAU khi role và quyền đã được tạo. Encode password trong URL.
DATABASE_URL=postgresql://REPLACE_WITH_EXISTING_DB_ROLE:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@127.0.0.1:5433/project_db

# ============================================================================
# 03. User authentication / JWT / trusted proxy
# ============================================================================
JWT_ISSUER=workspace-hub
# Cùng secret với User Service và các verifier; không dùng API key thay JWT.
JWT_SECRET_KEY=REPLACE_WITH_SHARED_JWT_SECRET_AT_LEAST_32_BYTES

# ============================================================================
# 04. API nội bộ HIỆN TẠI — giữ tới khi chuyển code
# ============================================================================
# LEGACY: hiện phải khớp các backend còn dùng key chung; API_INTERNAL_KEY bên dưới chưa thay thế được.
INTERNAL_SERVICE_KEY=REPLACE_WITH_SHARED_LEGACY_INTERNAL_KEY
# Nếu khai: phải bằng INTERNAL_SERVICE_KEY của Notification; nếu bỏ, code fallback key chung.
# NOTIFICATION_INTERNAL_SERVICE_KEY=REPLACE_WITH_SHARED_LEGACY_INTERNAL_KEY

# ============================================================================
# 05. Endpoint HTTP / timeout gọi service khác
# ============================================================================
COMMUNICATION_SERVICE_URL=http://127.0.0.1:8083
DOCUMENT_SERVICE_URL=http://127.0.0.1:8085
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8084
# SERVICE_HTTP_TIMEOUT_MS=5000
USER_SERVICE_URL=http://127.0.0.1:8081

# ============================================================================
# 06. Redis / Kafka / outbox
# ============================================================================
KAFKA_BROKER=127.0.0.1:9092
# OUTBOX_BATCH_SIZE=20
# OUTBOX_MAX_ATTEMPTS=5
# OUTBOX_POLL_INTERVAL_MS=2000
REDIS_URL=redis://127.0.0.1:6379

# ============================================================================
# 11. AI feature flags / model / RAG / speech
# ============================================================================
# Khớp AI/Project/Calendar; chỉ cần cho Work Assistant.
# WORK_ASSISTANT_SERVICE_KEY=REPLACE_WITH_SHARED_WORK_ASSISTANT_KEY

# ============================================================================
# 12. API key contract MỚI — PLANNED / CHƯA ĐƯỢC CODE HIỆN TẠI ĐỌC
# Chỉ chuẩn bị/đối chiếu. Chưa xóa key legacy bên trên.
# Mỗi target một secret; outgoing phải bằng API_INTERNAL_KEY của receiver.
# Key receiver không phân biệt các caller cùng giữ key; vẫn cần kiểm tra quyền user.
# ============================================================================
# Incoming: key của chính service này.
# API_INTERNAL_KEY=REPLACE_WITH_PROJECT_SERVICE_INTERNAL_KEY
# Outgoing → user; bằng API_INTERNAL_KEY tại receiver.
# API_USER_SERVICE_KEY=REPLACE_WITH_USER_SERVICE_INTERNAL_KEY
# Outgoing → communication; bằng API_INTERNAL_KEY tại receiver.
# API_COMMUNICATION_SERVICE_KEY=REPLACE_WITH_COMMUNICATION_SERVICE_INTERNAL_KEY
# Outgoing → document; bằng API_INTERNAL_KEY tại receiver.
# API_DOCUMENT_SERVICE_KEY=REPLACE_WITH_DOCUMENT_SERVICE_INTERNAL_KEY
# Outgoing → notification; bằng API_INTERNAL_KEY tại receiver.
# API_NOTIFICATION_SERVICE_KEY=REPLACE_WITH_NOTIFICATION_SERVICE_INTERNAL_KEY

