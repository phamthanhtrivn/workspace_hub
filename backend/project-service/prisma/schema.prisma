generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(100)
  description String?
  color       String?            @db.VarChar(20)
  icon        String?            @db.VarChar(10)
  ownerId     String             @map("owner_id") @db.Uuid
  status      String             @db.VarChar(20)
  projectType String             @default("GENERAL") @db.VarChar(30) @map("project_type")
  visibility  String             @default("MEMBERS_ONLY") @db.VarChar(20)
  startDate   DateTime?          @map("start_date")
  dueDate     DateTime?          @map("due_date")
  archived    Boolean            @default(false)
  version     BigInt             @default(0)
  createdAt   DateTime           @map("created_at")
  updatedAt   DateTime?          @map("updated_at")

  setting     ProjectSetting?
  members     ProjectMember[]
  tasks       Task[]
  sprints     Sprint[]
  invitations ProjectInvitation[]
  labels      TaskLabel[]
  dependencies TaskDependency[]

  @@index([ownerId, archived], map: "idx_projects_owner_archived")
  @@index([status, archived], map: "idx_projects_status_archived")
  @@map("projects")
}

model ProjectSetting {
  id                       String  @id @default(uuid()) @db.Uuid
  projectId                String  @unique @map("project_id") @db.Uuid
  allowMemberCreateTask    Boolean @default(false) @map("allow_member_create_task")
  allowMemberEditOthersTask Boolean @default(false) @map("allow_member_edit_others_task")
  allowMemberEditOwnTask  Boolean @default(false) @map("allow_member_edit_own_task")
  allowMemberInvite       Boolean @default(false) @map("allow_member_invite")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_settings")
}

model ProjectMember {
  id        String              @id @default(uuid()) @db.Uuid
  projectId String              @map("project_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  role      String              @db.VarChar(20)
  status    String              @default("ACTIVE") @db.VarChar(20)
  joinedAt  DateTime            @map("joined_at")
  leftAt    DateTime?           @map("left_at")
  updatedAt DateTime            @map("updated_at")
  version   BigInt              @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId], map: "uk_project_member_project_user")
  @@index([projectId, joinedAt], map: "idx_project_members_project_joined")
  @@map("project_members")
}

model Task {
  id                 String       @id @default(uuid()) @db.Uuid
  projectId          String       @map("project_id") @db.Uuid
  parentTaskId       String?      @map("parent_task_id") @db.Uuid
  title              String       @db.VarChar(200)
  description        String?
  priority           String       @db.VarChar(20)
  status             String       @db.VarChar(20)
  createdBy          String       @map("created_by") @db.Uuid
  reporterId         String       @map("reporter_id") @db.Uuid
  startDate          DateTime?    @map("start_date")
  dueDate            DateTime?    @map("due_date")
  allDay             Boolean      @default(false) @map("all_day")
  completedAt        DateTime?    @map("completed_at")
  completedBy        String?      @map("completed_by") @db.Uuid
  deletedAt          DateTime?    @map("deleted_at")
  estimatedMinutes   Int          @default(0) @map("estimated_minutes")
  rank               String?      @db.VarChar(100)
  archived           Boolean      @default(false)
  isParentTask       Boolean      @default(false) @map("is_parent_task")
  autoCompleteSprint Boolean      @default(false) @map("auto_complete_sprint")
  sprintId           String?      @map("sprint_id") @db.Uuid
  createdAt          DateTime     @map("created_at")
  updatedAt          DateTime?    @map("updated_at")
  version            BigInt       @default(0)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint    Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parent    Task?   @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children  Task[]  @relation("TaskHierarchy")
  comments  TaskComment[]
  activities TaskActivity[]
  checklists TaskChecklist[]
  assignees TaskAssignee[]
  labelMappings TaskLabelMapping[]
  dependenciesFrom TaskDependency[] @relation("DependencyPredecessor")
  dependenciesTo TaskDependency[] @relation("DependencySuccessor")

  @@index([projectId, archived, rank, createdAt], map: "idx_tasks_project_active_rank")
  @@index([projectId, dueDate], map: "idx_tasks_project_due")
  @@index([parentTaskId], map: "idx_tasks_parent")
  @@index([projectId, sprintId, archived], map: "idx_tasks_project_sprint_archived")
  @@unique([id, projectId], map: "uk_tasks_id_project")
  @@map("tasks")
}

model Sprint {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  name        String    @db.VarChar(200)
  goal        String?
  status      String    @default("PLANNED") @db.VarChar(20)
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")
  version     BigInt    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status, startDate], map: "idx_project_sprints_project_status_start")
  @@map("project_sprints")
}

model TaskChecklist {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  title       String   @db.VarChar(500)
  completed   Boolean  @default(false)
  completedBy String?  @map("completed_by") @db.Uuid
  createdAt   DateTime @map("created_at")
  rank        String?  @db.VarChar(100)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, rank, createdAt], map: "idx_task_checklists_task_rank")
  @@map("task_checklists")
}

model TaskAssignee {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @map("assigned_at")

  task Task @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)

  @@index([projectId, userId], map: "idx_task_assignees_project_user")
  @@map("task_assignees")
}

model TaskLabel {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String   @db.VarChar(50)
  color     String   @db.VarChar(20)

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mappings TaskLabelMapping[]

  @@unique([projectId, name], map: "uk_task_label_project_name")
  @@unique([id, projectId], map: "uk_task_labels_id_project")
  @@map("task_labels")
}

model TaskLabelMapping {
  id        String @id @default(uuid()) @db.Uuid
  taskId    String @map("task_id") @db.Uuid
  labelId   String @map("label_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  task  Task      @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  label TaskLabel @relation(fields: [labelId, projectId], references: [id, projectId], onDelete: Cascade)

  @@index([labelId], map: "idx_task_label_mappings_label")
  @@index([projectId], map: "idx_task_label_mappings_project")
  @@map("task_label_mappings")
}

model TaskDependency {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  predecessorTaskId String   @map("predecessor_task_id") @db.Uuid
  successorTaskId   String   @map("successor_task_id") @db.Uuid
  dependencyType    String   @default("FINISH_TO_START") @map("dependency_type") @db.VarChar(30)
  createdBy         String   @map("created_by") @db.Uuid
  createdAt         DateTime @map("created_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor Task    @relation("DependencyPredecessor", fields: [predecessorTaskId, projectId], references: [id, projectId], onDelete: Cascade)
  successor   Task    @relation("DependencySuccessor", fields: [successorTaskId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([projectId, predecessorTaskId, successorTaskId], map: "uk_task_dependency_project_predecessor_successor")
  @@index([projectId, successorTaskId], map: "idx_task_dependencies_successor")
  @@map("task_dependencies")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  edited    Boolean  @default(false)
  createdAt DateTime @map("created_at")
  updatedAt DateTime? @map("updated_at")
  version   BigInt   @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt], map: "idx_task_comments_task_created")
  @@map("task_comments")
}

model TaskActivity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  field     String   @db.VarChar(100)
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  createdAt DateTime @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt], map: "idx_task_activities_task_created")
  @@map("task_activities")
}

model ProjectInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  projectId     String           @map("project_id") @db.Uuid
  invitedUserId String           @map("invited_user_id") @db.Uuid
  invitedBy     String           @map("invited_by") @db.Uuid
  status        String           @default("PENDING") @db.VarChar(20)
  createdAt     DateTime         @map("created_at")
  respondedAt   DateTime?        @map("responded_at")
  expiresAt     DateTime?        @map("expires_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([invitedUserId, status, createdAt], map: "idx_project_invitation_recipient_status_created")
  @@index([projectId, status], map: "idx_project_invitation_project_status")
  @@map("project_invitations")
}
