# Merge into .env without replacing the existing application configuration.
# Access-token verification: synchronize with User Service and Kong; at least 32 UTF-8 bytes.
JWT_SECRET_KEY=
JWT_ISSUER=workspace-hub
# Required for authenticated profile backfill from User Service.
INTERNAL_SERVICE_KEY=
# Must match Document Service's CALENDAR_DOCUMENT_SERVICE_KEY (not its AI or legacy key).
CALENDAR_DOCUMENT_SERVICE_KEY=
