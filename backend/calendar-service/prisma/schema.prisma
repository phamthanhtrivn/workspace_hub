generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReminderMethod {
  ALERT
  PUSH
  EMAIL
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum AttendeeResponseStatus {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum EventVisibility {
  DEFAULT
  PRIVATE
  PUBLIC
}

enum EventSourceType {
  USER
  TASK
}

enum ReminderDeliveryStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
  CANCELLED
  DEAD_LETTER
}

enum RecurrenceExceptionType {
  EXCLUDED
}

model Calendar {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  name        String
  icon        String?
  description String?
  color       String
  timeZone    String   @default("Asia/Ho_Chi_Minh") @map("time_zone")
  isDefault   Boolean  @default(false) @map("is_default")
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  events           CalendarEvent[]
  recurrenceSeries RecurrenceSeries[]

  @@unique([ownerUserId, projectId])
  @@index([ownerUserId])
  @@index([projectId])
  @@map("calendars")
}

model RecurrenceSeries {
  id                       String          @id @default(uuid()) @db.Uuid
  calendarId               String          @map("calendar_id") @db.Uuid
  createdBy                String          @map("created_by") @db.Uuid
  updatedBy                String?         @map("updated_by") @db.Uuid
  title                    String
  description              String?
  location                 String?
  startAt                  DateTime        @map("start_at") @db.Timestamptz(3)
  endAt                    DateTime        @map("end_at") @db.Timestamptz(3)
  allDay                   Boolean         @default(false) @map("all_day")
  color                    String?
  status                   EventStatus     @default(CONFIRMED)
  visibility               EventVisibility @default(DEFAULT)
  sourceType               EventSourceType @default(USER) @map("source_type")
  recurrenceRule           String          @map("recurrence_rule")
  timeZone                 String          @map("time_zone")
  recurrenceGeneratedUntil DateTime?       @map("recurrence_generated_until") @db.Timestamptz(3)
  cancelledAt              DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendar   Calendar                   @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  events     CalendarEvent[]
  attendees  RecurrenceSeriesAttendee[]
  reminders  RecurrenceSeriesReminder[]
  documents  RecurrenceSeriesDocument[]
  exceptions RecurrenceException[]

  @@index([calendarId])
  @@index([status, recurrenceGeneratedUntil])
  @@map("recurrence_series")
}

model CalendarEvent {
  id                   String          @id @default(uuid()) @db.Uuid
  calendarId           String          @map("calendar_id") @db.Uuid
  createdBy            String          @map("created_by") @db.Uuid
  updatedBy            String?         @map("updated_by") @db.Uuid
  title                String
  description          String?
  location             String?
  startAt              DateTime        @map("start_at") @db.Timestamptz(3)
  endAt                DateTime        @map("end_at") @db.Timestamptz(3)
  allDay               Boolean         @default(false) @map("all_day")
  color                String?
  status               EventStatus     @default(CONFIRMED)
  visibility           EventVisibility @default(DEFAULT)
  recurrenceSeriesId   String?         @map("recurrence_series_id") @db.Uuid
  originalStartAt      DateTime?       @map("original_start_at") @db.Timestamptz(3)
  isRecurrenceOverride Boolean         @default(false) @map("is_recurrence_override")
  sourceType           EventSourceType @default(USER) @map("source_type")
  sourceId             String?         @map("source_id") @db.Uuid
  taskOrder            Int?            @map("task_order")
  completedAt          DateTime?       @map("completed_at") @db.Timestamptz(3)
  cancelledAt          DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendar         Calendar                @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  recurrenceSeries RecurrenceSeries?       @relation(fields: [recurrenceSeriesId], references: [id], onDelete: Cascade)
  attendees        CalendarEventAttendee[]
  reminders        Reminder[]
  documents        CalendarEventDocument[]
  pomodoroSessions PomodoroSession[]

  @@unique([recurrenceSeriesId, originalStartAt])
  @@unique([calendarId, sourceType, sourceId])
  @@index([calendarId, startAt])
  @@index([calendarId, taskOrder])
  @@index([createdBy])
  @@index([startAt, endAt])
  @@index([recurrenceSeriesId, startAt])
  @@index([sourceType, sourceId])
  @@map("calendar_events")
}

model RecurrenceSeriesAttendee {
  seriesId  String   @map("series_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  optional  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  series RecurrenceSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, userId])
  @@index([userId])
  @@map("recurrence_series_attendees")
}

model RecurrenceSeriesReminder {
  seriesId      String         @map("series_id") @db.Uuid
  minutesBefore Int            @map("minutes_before")
  method        ReminderMethod
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  series RecurrenceSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, method, minutesBefore])
  @@map("recurrence_series_reminders")
}

model RecurrenceSeriesDocument {
  seriesId   String   @map("series_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  series RecurrenceSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, documentId])
  @@index([documentId])
  @@map("recurrence_series_documents")
}

model CalendarEventAttendee {
  id             String                 @id @default(uuid()) @db.Uuid
  eventId        String                 @map("event_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  responseStatus AttendeeResponseStatus @default(NEEDS_ACTION) @map("response_status")
  optional       Boolean                @default(false)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("calendar_event_attendees")
}

model Reminder {
  id             String                 @id @default(uuid()) @db.Uuid
  eventId        String                 @map("event_id") @db.Uuid
  minutesBefore  Int                    @map("minutes_before")
  method         ReminderMethod
  scheduledAt    DateTime               @map("scheduled_at") @db.Timestamptz(3)
  deliveryStatus ReminderDeliveryStatus @default(PENDING) @map("delivery_status")
  attemptCount   Int                    @default(0) @map("attempt_count")
  nextAttemptAt  DateTime?              @map("next_attempt_at") @db.Timestamptz(3)
  dispatchedAt   DateTime?              @map("dispatched_at") @db.Timestamptz(3)
  lastError      String?                @map("last_error")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([deliveryStatus, scheduledAt, nextAttemptAt])
  @@map("reminders")
}

model CalendarEventDocument {
  eventId    String   @map("event_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, documentId])
  @@index([documentId])
  @@map("calendar_event_documents")
}

model RecurrenceException {
  id              String                  @id @default(uuid()) @db.Uuid
  seriesId        String                  @map("series_id") @db.Uuid
  occurrenceStart DateTime                @map("occurrence_start") @db.Timestamptz(3)
  type            RecurrenceExceptionType @default(EXCLUDED)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  series RecurrenceSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, occurrenceStart])
  @@index([seriesId, occurrenceStart])
  @@map("recurrence_exceptions")
}

model UserProfileSnapshot {
  userId    String   @id @map("user_id") @db.Uuid
  email     String?
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  syncedAt  DateTime @default(now()) @updatedAt @map("synced_at") @db.Timestamptz(3)

  @@map("user_profile_snapshots")
}

model TaskCalendarSyncCheckpoint {
  taskId     String   @id @map("task_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  eventType  String   @map("event_type")
  syncedAt   DateTime @default(now()) @updatedAt @map("synced_at") @db.Timestamptz(3)

  @@index([occurredAt])
  @@map("task_calendar_sync_checkpoints")
}

enum PomodoroSessionType {
  FOCUS
  SHORT_BREAK
  LONG_BREAK
}

enum PomodoroSessionStatus {
  COMPLETED
  STOPPED
  SKIPPED
}

model PomodoroSession {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @map("user_id") @db.Uuid
  clientSessionId    String?               @map("client_session_id") @db.VarChar(100)
  eventId            String?               @map("event_id") @db.Uuid
  taskId             String?               @map("task_id") @db.Uuid
  taskTitle          String?               @map("task_title") @db.VarChar(500)
  projectId          String?               @map("project_id") @db.Uuid
  projectName        String?               @map("project_name") @db.VarChar(500)
  sessionType        PomodoroSessionType   @map("session_type")
  status             PomodoroSessionStatus
  startedAt          DateTime              @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime              @map("ended_at") @db.Timestamptz(3)
  plannedSeconds     Int                   @map("planned_seconds")
  actualSeconds      Int                   @map("actual_seconds")
  notes              String?
  interruptionReason String?               @map("interruption_reason")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  event CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@unique([userId, clientSessionId])
  @@index([eventId, startedAt])
  @@index([taskId, startedAt])
  @@map("calendar_pomodoro_sessions")
}

enum PomodoroAudioCategory {
  music
  nature
  ambient
}

model PomodoroAudio {
  id          String                @id @db.VarChar(128)
  name        String                @db.VarChar(200)
  description String
  icon        String                @db.VarChar(64)
  category    PomodoroAudioCategory
  s3Key       String                @map("s3_key")
  sortOrder   Int                   @default(0) @map("sort_order")
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder, id])
  @@map("calendar_pomodoro_audios")
}

model PomodoroConfig {
  userId              String   @id @map("user_id") @db.Uuid
  focusDuration       Int      @default(25) @map("focus_duration")
  shortBreak          Int      @default(5) @map("short_break")
  longBreak           Int      @default(15) @map("long_break")
  longBreakInterval   Int      @default(2) @map("long_break_interval")
  autoStartBreak      Boolean  @default(false) @map("auto_start_break")
  autoStartFocus      Boolean  @default(false) @map("auto_start_focus")
  soundEnabled        Boolean  @default(true) @map("sound_enabled")
  soundType           String   @default("chime") @map("sound_type") @db.VarChar(20)
  soundVolume         Float    @default(0.7) @map("sound_volume")
  notificationEnabled Boolean  @default(true) @map("notification_enabled")
  dailyGoalPomodoros  Int      @default(8) @map("daily_goal_pomodoros")
  ambientTrackId      String   @default("lofi_relax") @map("ambient_track_id") @db.VarChar(128)
  ambientVolume       Float    @default(0.5) @map("ambient_volume")
  ambientAutoPlayOnFocus Boolean @default(true) @map("ambient_auto_play_on_focus")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("calendar_pomodoro_configs")
}

enum PomodoroTimerStatus {
  IDLE
  RUNNING
  PAUSED
}

model PomodoroTimerState {
  plannedSeconds   Int?                 @map("planned_seconds")
  userId           String               @id @map("user_id") @db.Uuid
  mode             PomodoroSessionType
  status           PomodoroTimerStatus
  targetEndAt      DateTime?            @map("target_end_at") @db.Timestamptz(3)
  remainingSeconds Int                  @map("remaining_seconds")
  cycleCount       Int                  @map("cycle_count")
  sessionStartAt   DateTime?            @map("session_start_at") @db.Timestamptz(3)
  eventId          String?              @map("event_id") @db.Uuid
  taskId           String?              @map("task_id") @db.Uuid
  activeTask       Json?                @map("active_task")
  notes            String               @default("")
  version          Int                  @default(1)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("calendar_pomodoro_timer_states")
}

model NotificationOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(50)
  payload       Json
  status        String    @default("PENDING") @db.VarChar(20)
  attemptCount  Int       @default(0) @map("attempt_count")
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)

  @@map("notification_outbox")
}
