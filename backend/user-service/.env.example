# WorkSpaceHub — user-service — LOCAL DEVELOPMENT
# So sánh với .env hiện tại trước khi copy. Thay REPLACE_* bằng giá trị local của bạn.
# Dòng không comment: cấu hình nền cho mẫu này; vẫn phải điền credential/URL thật.
# Dòng "# NAME=...": tùy chọn, tuning hoặc feature có điều kiện; chỉ bỏ comment khi dùng.
# Không commit .env thật. File này KHÔNG triển khai phần fix security.
# Các key API_* ở cuối file là kế hoạch, hiện CHƯA được source đọc.

# Spring không tự đọc .env theo cấu hình hiện tại: inject qua IDE/launcher trước khi chạy.

# ============================================================================
# 02. Database / schema tooling (credential hiện tại)
# ============================================================================
# Chỉ script reconcile-auth-schema.mjs; nếu bỏ, script dùng POSTGRES_USERNAME. Không phải biến Spring runtime.
# PGUSER=REPLACE_WITH_SCHEMA_RECONCILIATION_DB_ROLE
POSTGRES_DB=user_db
POSTGRES_HOST=127.0.0.1
# Giữ credential hiện hữu. Đổi biến init container không tự đổi password trong volume cũ.
POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_DB_PASSWORD
# Ví dụ local dùng host port 5433; phải khớp port đang publish, không tự đổi volume/DB.
POSTGRES_PORT=5433
POSTGRES_USERNAME=REPLACE_WITH_EXISTING_USER_DB_ROLE

# ============================================================================
# 03. User authentication / JWT / trusted proxy
# ============================================================================
# Cùng secret với User Service và các verifier; không dùng API key thay JWT.
JWT_SECRET_KEY=REPLACE_WITH_SHARED_JWT_SECRET_AT_LEAST_32_BYTES
# Chỉ khai CIDR proxy thật đứng trước User Service; không tin X-Forwarded-For tùy ý.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ============================================================================
# 04. API nội bộ HIỆN TẠI — giữ tới khi chuyển code
# ============================================================================
# LEGACY: hiện phải khớp các backend còn dùng key chung; API_INTERNAL_KEY bên dưới chưa thay thế được.
INTERNAL_SERVICE_KEY=REPLACE_WITH_SHARED_LEGACY_INTERNAL_KEY

# ============================================================================
# 06. Redis / Kafka / outbox
# ============================================================================
KAFKA_BROKER=127.0.0.1:9092
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ============================================================================
# 07. AWS S3 / media storage
# ============================================================================
# Có thể bỏ cả cặp AWS key khi SDK dùng credential chain; recording hiện còn yêu cầu cặp này để bật.
# AWS_ACCESS_KEY=REPLACE_WITH_AWS_ACCESS_KEY
# Giữ media base URL hiện hữu. Calendar chỉ dùng cho audio; không biến document riêng tư thành public.
AWS_CLOUDFRONT_URL=https://media.example.com
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=replace-with-your-bucket
# Phải đi cùng AWS_ACCESS_KEY nếu dùng static credentials; không commit credential thật.
# AWS_SECRET_KEY=REPLACE_WITH_AWS_SECRET_KEY

# ============================================================================
# 08. Email SMTP / Google OAuth
# ============================================================================
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
MAIL_HOST=smtp.example.com
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username

# ============================================================================
# 12. API key contract MỚI — PLANNED / CHƯA ĐƯỢC CODE HIỆN TẠI ĐỌC
# Chỉ chuẩn bị/đối chiếu. Chưa xóa key legacy bên trên.
# Mỗi target một secret; outgoing phải bằng API_INTERNAL_KEY của receiver.
# Key receiver không phân biệt các caller cùng giữ key; vẫn cần kiểm tra quyền user.
# ============================================================================
# Incoming: key của chính service này.
# API_INTERNAL_KEY=REPLACE_WITH_USER_SERVICE_INTERNAL_KEY

