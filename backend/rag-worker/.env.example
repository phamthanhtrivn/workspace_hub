# WorkSpaceHub — rag-worker — LOCAL DEVELOPMENT
# So sánh với .env hiện tại trước khi copy. Thay REPLACE_* bằng giá trị local của bạn.
# Dòng không comment: cấu hình nền cho mẫu này; vẫn phải điền credential/URL thật.
# Dòng "# NAME=...": tùy chọn, tuning hoặc feature có điều kiện; chỉ bỏ comment khi dùng.
# Không commit .env thật. File này KHÔNG triển khai phần fix security.
# Các key API_* ở cuối file là kế hoạch, hiện CHƯA được source đọc.

# Python worker không tự đọc file này: cần launcher/uvicorn --env-file hoặc container env_file.

# ============================================================================
# 11. AI feature flags / model / RAG / speech
# ============================================================================
# Chỉ dùng khi EMBEDDING_PROVIDER=api; credential của nhà cung cấp embedding.
# EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_PROVIDER_KEY
# EMBEDDING_BASE_URL=https://replace-with-embedding-provider.example.com/v1
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# local dùng model trên máy; api cần endpoint/key/model tương ứng.
EMBEDDING_PROVIDER=local
# INDEX_PIPELINE_VERSION=notebook-v1
# Chỉ khai nếu Qdrant server bật API key; phải khớp server.
# QDRANT_API_KEY=REPLACE_WITH_QDRANT_SERVER_KEY
QDRANT_URL=http://127.0.0.1:6333
# Khớp AI và RAG; worker yêu cầu ít nhất 32 ký tự.
RAG_SERVICE_KEY=REPLACE_WITH_SHARED_RAG_SERVICE_KEY
# Chỉ trong cửa sổ xoay key còn hiệu lực; bỏ hẳn khi không dùng, không để placeholder active.
# RAG_SERVICE_KEY_PREVIOUS=REPLACE_ONLY_DURING_ACTIVE_KEY_ROTATION
# Bật đồng bộ AI/RAG theo feature. Source AI hiện giới hạn visual egress origin https://vibi.top.
VISUAL_ENABLED=false

# ============================================================================
# 12. API key contract MỚI — PLANNED / CHƯA ĐƯỢC CODE HIỆN TẠI ĐỌC
# Chỉ chuẩn bị/đối chiếu. Chưa xóa key legacy bên trên.
# Mỗi target một secret; outgoing phải bằng API_INTERNAL_KEY của receiver.
# Key receiver không phân biệt các caller cùng giữ key; vẫn cần kiểm tra quyền user.
# ============================================================================
# Incoming: key của chính service này.
# API_INTERNAL_KEY=REPLACE_WITH_RAG_SERVICE_INTERNAL_KEY

