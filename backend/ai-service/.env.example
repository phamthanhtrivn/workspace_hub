NODE_ENV=development
HOST=0.0.0.0
PORT=8087
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Enable only after configuring a demo Gemini project and running migrations.
AI_ENABLED=false
# Host: postgresql+psycopg://USER:PASSWORD_URLENCODED@localhost:5432/ai_db
# Do not append Prisma's ?schema=public; psycopg does not accept that parameter.
DATABASE_URL=
JWT_SECRET_KEY=
JWT_ISSUER=workspace-hub
INTERNAL_SERVICE_KEY=
DOCUMENT_SERVICE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Application admission caps; set at or below your AI Studio project quota.
GEMINI_REQUESTS_PER_MINUTE=5
GEMINI_REQUESTS_PER_DAY=100
GEMINI_TOKENS_PER_MINUTE=20000
RETENTION_DAYS=30
