# WorkSpaceHub — ai-service — LOCAL DEVELOPMENT
# So sánh với .env hiện tại trước khi copy. Thay REPLACE_* bằng giá trị local của bạn.
# Dòng không comment: cấu hình nền cho mẫu này; vẫn phải điền credential/URL thật.
# Dòng "# NAME=...": tùy chọn, tuning hoặc feature có điều kiện; chỉ bỏ comment khi dùng.
# Không commit .env thật. File này KHÔNG triển khai phần fix security.
# Các key API_* ở cuối file là kế hoạch, hiện CHƯA được source đọc.

# ============================================================================
# 01. Runtime / frontend / CORS
# ============================================================================
BIND_HOST=127.0.0.1
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
PORT=8087

# ============================================================================
# 02. Database / schema tooling (credential hiện tại)
# ============================================================================
# Giữ DB/role/password đang dùng; chỉ đổi sang role riêng SAU khi role và quyền đã được tạo. Encode password trong URL.
DATABASE_URL=postgresql://REPLACE_WITH_EXISTING_DB_ROLE:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@127.0.0.1:5433/REPLACE_WITH_EXISTING_AI_DATABASE_NAME

# ============================================================================
# 03. User authentication / JWT / trusted proxy
# ============================================================================
JWT_ISSUER=workspace-hub
# Cùng secret với User Service và các verifier; không dùng API key thay JWT.
JWT_SECRET_KEY=REPLACE_WITH_SHARED_JWT_SECRET_AT_LEAST_32_BYTES

# ============================================================================
# 04. API nội bộ HIỆN TẠI — giữ tới khi chuyển code
# ============================================================================
# LEGACY: hiện phải khớp các backend còn dùng key chung; API_INTERNAL_KEY bên dưới chưa thay thế được.
INTERNAL_SERVICE_KEY=REPLACE_WITH_SHARED_LEGACY_INTERNAL_KEY

# ============================================================================
# 05. Endpoint HTTP / timeout gọi service khác
# ============================================================================
# COMMUNICATION_SERVICE_URL=http://127.0.0.1:8083
DOCUMENT_SERVICE_URL=http://127.0.0.1:8085
# MEETING_STT_URL=http://127.0.0.1:8090
RAG_WORKER_URL=http://127.0.0.1:8088
USER_SERVICE_URL=http://127.0.0.1:8081
# WORK_ASSISTANT_CALENDAR_URL=http://127.0.0.1:8086
# WORK_ASSISTANT_PROJECT_URL=http://127.0.0.1:8082

# ============================================================================
# 06. Redis / Kafka / outbox
# ============================================================================
REDIS_URL=redis://127.0.0.1:6379

# ============================================================================
# 11. AI feature flags / model / RAG / speech
# ============================================================================
# Khớp AI và Communication; cần khi bật Conversation AI hoặc Meeting Summary.
# AI_COMMUNICATION_SERVICE_KEY=REPLACE_WITH_SHARED_AI_COMMUNICATION_KEY
# Khớp AI và Document; cần khi bật tích hợp tài liệu AI.
# AI_DOCUMENT_SERVICE_KEY=REPLACE_WITH_SHARED_AI_DOCUMENT_KEY
AI_ENABLED=false
# Khớp Kong và AI; code hiện dùng tên này cho gateway proof.
# AI_GATEWAY_KEY=REPLACE_WITH_SHARED_AI_GATEWAY_KEY
# Chỉ trong cửa sổ xoay key còn hiệu lực; bỏ hẳn khi không dùng, không để placeholder active.
# AI_GATEWAY_KEY_PREVIOUS=REPLACE_ONLY_DURING_ACTIVE_KEY_ROTATION
# AI_SHUTDOWN_TIMEOUT_MS=210000
# CHAT_CANCEL_POLL_MS=2000
# CONVERSATION_AI_CONCURRENCY=2
# Bật đồng bộ Communication/AI và cấu hình AI_COMMUNICATION_SERVICE_KEY.
CONVERSATION_AI_ENABLED=false
# CONVERSATION_AI_MAX_TOKENS=4096
# CONVERSATION_AI_MODEL=replace-with-supported-model
# CONVERSATION_AI_QUOTA_WAIT_MS=60000
# Lấy từ provider; Zod hiện vẫn yêu cầu chuỗi không rỗng kể cả AI tắt.
LLM_API_KEY=REPLACE_WITH_LLM_PROVIDER_API_KEY
# Zod hiện vẫn yêu cầu URL kể cả AI_ENABLED=false; giữ config provider hiện hữu.
LLM_BASE_URL=https://replace-with-provider.example.com/v1
# LLM_MAX_TOKENS=4096
# Model ID do provider hỗ trợ; không dùng placeholder để gọi thật.
LLM_MODEL=replace-with-supported-model
# LLM_REQUESTS_PER_DAY=100
# LLM_REQUESTS_PER_MINUTE=5
# LLM_TIMEOUT_MS=90000
# LLM_TOKENS_PER_MINUTE=20000
# MEETING_FFMPEG_PATH=ffmpeg
# MEETING_MEDIA_HOSTS=REPLACE_WITH_RECORDING_STORAGE_HOST
# MEETING_STT_CONCURRENCY=1
# Bằng SPEECH_SERVICE_KEY của worker; start-local-speech.mjs hiện lấy biến này từ ai-service/.env.
# MEETING_STT_SERVICE_KEY=REPLACE_WITH_SHARED_SPEECH_SERVICE_KEY
# MEETING_STT_TIMEOUT_MS=180000
# Bật đồng bộ Communication/AI; cần speech worker, media allowlist và key đúng.
MEETING_SUMMARY_ENABLED=false
# MEETING_SUMMARY_MAX_BYTES=1073741824
# MEETING_SUMMARY_MAX_SECONDS=7200
# Khớp AI và RAG; worker yêu cầu ít nhất 32 ký tự.
# RAG_SERVICE_KEY=REPLACE_WITH_SHARED_RAG_SERVICE_KEY
# VISION_MAX_TOKENS=2048
# Bật đồng bộ AI/RAG theo feature. Source AI hiện giới hạn visual egress origin https://vibi.top.
VISUAL_ENABLED=false
# Mẫu tắt. Bật cần WORK_ASSISTANT_SERVICE_KEY khớp Project và Calendar.
WORK_ASSISTANT_ENABLED=false
# Khớp AI/Project/Calendar; chỉ cần cho Work Assistant.
# WORK_ASSISTANT_SERVICE_KEY=REPLACE_WITH_SHARED_WORK_ASSISTANT_KEY

# ============================================================================
# 12. API key contract MỚI — PLANNED / CHƯA ĐƯỢC CODE HIỆN TẠI ĐỌC
# Chỉ chuẩn bị/đối chiếu. Chưa xóa key legacy bên trên.
# Mỗi target một secret; outgoing phải bằng API_INTERNAL_KEY của receiver.
# Key receiver không phân biệt các caller cùng giữ key; vẫn cần kiểm tra quyền user.
# ============================================================================
# Incoming: key của chính service này.
# API_INTERNAL_KEY=REPLACE_WITH_AI_SERVICE_INTERNAL_KEY
# Outgoing → user; bằng API_INTERNAL_KEY tại receiver.
# API_USER_SERVICE_KEY=REPLACE_WITH_USER_SERVICE_INTERNAL_KEY
# Outgoing → project; bằng API_INTERNAL_KEY tại receiver.
# API_PROJECT_SERVICE_KEY=REPLACE_WITH_PROJECT_SERVICE_INTERNAL_KEY
# Outgoing → calendar; bằng API_INTERNAL_KEY tại receiver.
# API_CALENDAR_SERVICE_KEY=REPLACE_WITH_CALENDAR_SERVICE_INTERNAL_KEY
# Outgoing → communication; bằng API_INTERNAL_KEY tại receiver.
# API_COMMUNICATION_SERVICE_KEY=REPLACE_WITH_COMMUNICATION_SERVICE_INTERNAL_KEY
# Outgoing → document; bằng API_INTERNAL_KEY tại receiver.
# API_DOCUMENT_SERVICE_KEY=REPLACE_WITH_DOCUMENT_SERVICE_INTERNAL_KEY
# Outgoing → rag; bằng API_INTERNAL_KEY tại receiver.
# API_RAG_SERVICE_KEY=REPLACE_WITH_RAG_SERVICE_INTERNAL_KEY
# Outgoing → speech; bằng API_INTERNAL_KEY tại receiver.
# API_SPEECH_SERVICE_KEY=REPLACE_WITH_SPEECH_SERVICE_INTERNAL_KEY

