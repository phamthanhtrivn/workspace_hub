PORT=8087
AI_ENABLED=false
AI_SHUTDOWN_TIMEOUT_MS=210000
CHAT_CANCEL_POLL_MS=2000
NODE_ENV=development
# Host API is trusted-local only; use Kong for browser requests.
BIND_HOST=127.0.0.1
# Existing ai_db is preserved; migrations create a separate notebook_ai schema.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/ai_db
REDIS_URL=redis://localhost:6379/2
# Generate and synchronize dedicated credentials with backend/scripts/configure-ai-security.mjs.
# Required when AI_ENABLED=true, including local development. Never expose to the browser.
AI_GATEWAY_KEY=
AI_GATEWAY_KEY_PREVIOUS=
AI_DOCUMENT_SERVICE_KEY=
RAG_SERVICE_KEY=
DOCUMENT_SERVICE_URL=http://localhost:8085
RAG_WORKER_URL=http://localhost:8088
FRONTEND_URL=http://localhost:3000
LLM_BASE_URL=https://vibi.top/v1/
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
VISUAL_ENABLED=false
VISION_MAX_TOKENS=2048
LLM_TIMEOUT_MS=90000
LLM_MAX_TOKENS=4096
LLM_REQUESTS_PER_MINUTE=5
LLM_TOKENS_PER_MINUTE=20000
LLM_REQUESTS_PER_DAY=200

# Optional @ai overrides; unset values inherit LLM_MODEL / LLM_MAX_TOKENS.
# CONVERSATION_AI_MODEL=gpt-6.1-sol
# CONVERSATION_AI_MAX_TOKENS=2048
CONVERSATION_AI_CONCURRENCY=2
CONVERSATION_AI_QUOTA_WAIT_MS=60000

# Meeting recordings: local faster-whisper -> configured summary model.
# Setup: deploy/ai/README.md; verification: docs/testing/meeting-local-speech-verification.md.
MEETING_SUMMARY_ENABLED=false
MEETING_STT_CONCURRENCY=1
MEETING_STT_URL=http://127.0.0.1:8090
MEETING_STT_SERVICE_KEY=
MEETING_STT_TIMEOUT_MS=180000
MEETING_FFMPEG_PATH=ffmpeg
MEETING_SUMMARY_MAX_SECONDS=7200
MEETING_SUMMARY_MAX_BYTES=1073741824
# Exact hosts (including a non-default port), comma separated. No wildcards.
MEETING_MEDIA_HOSTS=

# Private read-only work assistant. Synchronize service keys with backend/scripts/configure-work-assistant.mjs.
WORK_ASSISTANT_ENABLED=true
WORK_ASSISTANT_SERVICE_KEY=
WORK_ASSISTANT_PROJECT_URL=http://localhost:8082
WORK_ASSISTANT_CALENDAR_URL=http://localhost:8086
