PORT=8087
AI_ENABLED=false
NODE_ENV=development
# Host API is trusted-local only; use Kong for browser requests.
BIND_HOST=127.0.0.1
# Existing ai_db is preserved; migrations create a separate notebook_ai schema.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/ai_db
REDIS_URL=redis://localhost:6379/2
# Generate and synchronize dedicated credentials with backend/scripts/configure-ai-security.mjs.
# Required when AI_ENABLED=true, including local development. Never expose to the browser.
AI_GATEWAY_KEY=
AI_GATEWAY_KEY_PREVIOUS=
AI_DOCUMENT_SERVICE_KEY=
RAG_SERVICE_KEY=
DOCUMENT_SERVICE_URL=http://localhost:8085
RAG_WORKER_URL=http://localhost:8088
FRONTEND_URL=http://localhost:3000
LLM_BASE_URL=https://vibi.top/v1/
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=1600
LLM_REQUESTS_PER_MINUTE=5
LLM_TOKENS_PER_MINUTE=20000
LLM_REQUESTS_PER_DAY=200
