# Standalone development stack, separate from the old ai_db and its volumes.
AI_ENABLED=false
NODE_ENV=development
BIND_HOST=0.0.0.0
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://notebook:CHANGE_ME@notebook-db:5432/notebook_db
REDIS_URL=redis://notebook-redis:6379/0
PORT=8087
# Generate and synchronize using backend/scripts/configure-ai-security.mjs (from repository root).
# Each link uses a DIFFERENT key; blank/short keys are never accepted, even locally.
AI_GATEWAY_KEY=
AI_GATEWAY_KEY_PREVIOUS=
AI_DOCUMENT_SERVICE_KEY=
RAG_SERVICE_KEY=
RAG_SERVICE_KEY_PREVIOUS=
DOCUMENT_SERVICE_URL=http://host.docker.internal:8085
RAG_WORKER_URL=http://rag-worker:8088
FRONTEND_URL=http://localhost:3000
LLM_BASE_URL=https://vibi.top/v1/
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=1600
LLM_REQUESTS_PER_MINUTE=5
LLM_TOKENS_PER_MINUTE=20000
LLM_REQUESTS_PER_DAY=100
QDRANT_URL=http://notebook-qdrant:6333
QDRANT_API_KEY=
# Lightweight multilingual CPU baseline; evaluate against BAAI/bge-m3 before rollout.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
INDEX_PIPELINE_VERSION=notebook-v1
OMP_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
