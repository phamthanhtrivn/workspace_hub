# Merge into deploy/ai/.env. Keep the real key only in the ignored .env file.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Optional dual-model indexing/search. This is Embedding 2's exact model ID.
EMBEDDING_SECONDARY_MODEL=gemini-embedding-2
# Optional third model, loaded from the local cache with a separate 384-D collection.
EMBEDDING_LOCAL_ENABLED=true
# Each source is assigned to one stable model. Verify/migrate existing indexes before enabling.
EMBEDDING_INDEX_STRATEGY=shard
# Persistent chunk cache lives on the existing /models volume (30 days, at most 20,000 entries).
RAG_MEMORY_LIMIT=3g
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_CONCURRENCY=5
EMBEDDING_API_KEY=

# Host API/workers read backend/ai-service/api/.env instead.
NOTEBOOK_INDEX_CONCURRENCY=5
NOTEBOOK_INDEX_TIMEOUT_MS=900000

# Changing provider/model/dimensions creates a separate Qdrant collection.
# Re-embed existing indexed chunks before switching live retrieval to Gemini.
