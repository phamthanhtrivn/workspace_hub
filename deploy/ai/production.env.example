# Production AI on APP; replace example INFRA address with INFRA_PRIVATE_HOST.
# Credentials must be provisioned separately from local; leave provider key blank until supplied.
AI_IMAGE=
RAG_IMAGE=
SPEECH_IMAGE=
# Shared PostgreSQL 15 / Redis on INFRA; AI workloads run on APP.
AI_ENABLED=false
AI_SHUTDOWN_TIMEOUT_MS=210000
CHAT_CANCEL_POLL_MS=2000
NODE_ENV=production
BIND_HOST=0.0.0.0
AI_APP_NETWORK=workspacehub-app_default
NOTEBOOK_ADMIN_HOST=10.0.0.10
NOTEBOOK_ADMIN_PORT=5432
NOTEBOOK_POSTGRES_USER=notebook
NOTEBOOK_POSTGRES_PASSWORD=
DATABASE_URL=postgresql://notebook:CHANGE_ME@10.0.0.10:5432/notebook_db
REDIS_URL=redis://10.0.0.10:6379/3
PORT=8087
# Generate and synchronize using backend/scripts/configure-ai-security.mjs (from repository root).
# Each link uses a DIFFERENT key; blank/short keys are never accepted, even locally.
AI_GATEWAY_KEY=
AI_GATEWAY_KEY_PREVIOUS=
AI_DOCUMENT_SERVICE_KEY=
RAG_SERVICE_KEY=
RAG_SERVICE_KEY_PREVIOUS=
DOCUMENT_SERVICE_URL=http://document-service:8085
RAG_WORKER_URL=http://rag-worker:8088
FRONTEND_URL=https://app.example.com
LLM_BASE_URL=https://vibi.top/v1/
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
VISUAL_ENABLED=false
VISION_MAX_TOKENS=2048
LLM_TIMEOUT_MS=90000
LLM_MAX_TOKENS=4096
LLM_REQUESTS_PER_MINUTE=5
LLM_TOKENS_PER_MINUTE=20000
LLM_REQUESTS_PER_DAY=100
QDRANT_URL=http://notebook-qdrant:6333
QDRANT_API_KEY=
# Lightweight multilingual CPU baseline; evaluate against BAAI/bge-m3 before rollout.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
INDEX_PIPELINE_VERSION=notebook-v1
OMP_NUM_THREADS=2
RAG_MEMORY_LIMIT=2g
TOKENIZERS_PARALLELISM=false

# Optional conversation bot; synchronize via backend/scripts/configure-conversation-ai.mjs.
CONVERSATION_AI_ENABLED=false
AI_COMMUNICATION_SERVICE_KEY=
COMMUNICATION_SERVICE_URL=http://communication-service:8083

# Optional @ai overrides; unset values inherit LLM_MODEL / LLM_MAX_TOKENS.
# CONVERSATION_AI_MODEL=gpt-6.1-sol
# CONVERSATION_AI_MAX_TOKENS=2048
CONVERSATION_AI_CONCURRENCY=2
CONVERSATION_AI_QUOTA_WAIT_MS=60000

# Meeting summaries are opt-in; speech-worker recognizes audio locally on CPU.
MEETING_SUMMARY_ENABLED=false
MEETING_STT_CONCURRENCY=1
MEETING_STT_URL=http://speech-worker:8090
MEETING_STT_SERVICE_KEY=
MEETING_STT_TIMEOUT_MS=180000
MEETING_FFMPEG_PATH=ffmpeg
MEETING_SUMMARY_MAX_SECONDS=7200
MEETING_SUMMARY_MAX_BYTES=1073741824
MEETING_MEDIA_HOSTS=

# Private read-only assistant; synchronize with Project/Calendar.
WORK_ASSISTANT_ENABLED=false
WORK_ASSISTANT_SERVICE_KEY=
WORK_ASSISTANT_PROJECT_URL=http://project-service:8082
WORK_ASSISTANT_CALENDAR_URL=http://calendar-service:8086
